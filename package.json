{
  "name": "portami",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA anónima y colaborativa para rastrear buses y trens en tiempo real",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "analyze": "ANALYZE=1 npm run build && echo 'Open dist/stats.html in a browser'",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@mcp-b/global": "^5.1.0",
    "@mcp-b/webmcp-types": "^5.1.0",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "idb": "^8.0.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.27.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/leaflet": "^1.9.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "msw": "^2.4.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2",
    "workbox-window": "^7.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
