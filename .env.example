# Backend API base URL.
# - Leave empty in dev: MSW mocks are used.
# - Set to the deployed server URL in production:
#     VITE_API_BASE=https://portami-server-6mv9bn5jhvvb.gabrielcatdev.deno.net
VITE_API_BASE=

# Base path for static hosting. Use:
# - `/`         when serving at the root (e.g. https://gabrielcatdeveloper.github.io/)
# - `/portami/` when serving under a subpath (e.g. https://gabrielcatdeveloper.github.io/portami/)
VITE_BASE_PATH=/