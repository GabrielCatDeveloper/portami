# Backend API base URL.
# - Leave empty in dev: MSW mocks are used.
# - Set to the deployed server URL in production:
#     VITE_API_BASE=https://portami-server-myqe6vtk46ha.gabrielcatdev.deno.net
VITE_API_BASE=

# Base path for static hosting (GitHub Pages /portami/, custom domain /).
VITE_BASE_PATH=/portami/